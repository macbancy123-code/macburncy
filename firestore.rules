rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products Collection
    match /products/{productId} {
      // Allow everyone to view products (Public)
      allow read: if true;
      
      // ONLY allow authenticated admins to modify the inventory
      // request.auth != null ensures the user is logged in via Firebase Auth
      allow write: if request.auth != null;
    }
    
    // Orders Collection
    match /orders/{orderId} {
      allow create, update: if true;
      allow read: if true; // Allow customers to maybe see their status later, or restrict to admin
    }

    // Contact Submissions (if added later)
    match /submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false; // Only admin can read from Firebase Console
    }
  }
}
